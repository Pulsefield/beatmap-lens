{
  "name": "@ensomi/beatmap-lens-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "annotation:workflow": "node apps/inspector/server/annotation-workflow.mjs",
    "dataset:release": "uv run --locked python annotation/release/dataset-release.py",
    "review:workspace": "node apps/inspector/server/review-workspace.mjs",
    "benchmark": "vitest bench --run",
    "build": "pnpm --recursive --if-present build",
    "catalog:map-local": "node scripts/build-pattern-category-map.mjs",
    "changeset": "changeset",
    "check": "pnpm check:source && pnpm check:skill && pnpm typecheck && pnpm test && pnpm test:python && pnpm build && pnpm check:package && pnpm test:corpus-validator && pnpm test:pattern-category-map",
    "check:package": "pnpm --filter beatmap-lens pack --dry-run",
    "check:source": "biome ci .",
    "dev": "pnpm --filter @ensomi/beatmap-lens-inspector dev",
    "format": "biome check --write .",
    "release": "pnpm build && changeset publish",
    "test": "uv run --locked vitest run",
    "test:corpus-validator": "node scripts/test-corpus-validator.mjs",
    "test:pattern-category-map": "node scripts/test-pattern-category-map.mjs",
    "test:watch": "uv run --locked vitest",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "prevalidate:corpus": "pnpm --filter beatmap-lens build",
    "validate:corpus": "node scripts/validate-corpus.mjs",
    "version-packages": "changeset version",
    "check:skill": "uv run --locked python .agents/skills/mania-pattern-judgment/scripts/check_budget.py",
    "test:python": "uv run --locked python scripts/test-python.py",
    "check:regression": "uv run --locked python annotation/evaluation/regression_gate.py check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/cli": "2.31.1",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "happy-dom": "20.12.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
