{
  "name": "beatmap-lens",
  "version": "0.1.0",
  "description": "A TypeScript toolkit for 4K-10K osu!mania beatmaps.",
  "keywords": [
    "osu",
    "osu-mania",
    "beatmap",
    "parser",
    "svg"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Pulsefield/beatmap-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pulsefield/beatmap-lens.git",
    "directory": "packages/beatmap-lens"
  },
  "bugs": {
    "url": "https://github.com/Pulsefield/beatmap-lens/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
